# Copy this file to .env and adjust if needed. .env is gitignored.
#
# This is the TEST FRAMEWORK's own config — separate from the root .env, which
# configures the Docker Compose services. Tests run on the host and talk to
# services via localhost; containers talk to each other via service names
# (e.g. DATABASE_URL here uses "localhost", the root .env uses "postgres").

# Base URLs the test framework talks to (see README's "Running" section)
API_BASE_URL=http://localhost:4000/
WEB_BASE_URL=http://localhost:3000

# Host-side Postgres connection. global.setup.ts uses this to truncate and
# reseed the database before each test run.
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian

# Shared password for every seeded user (see README's "Seeded data" table)
SEED_USER_PASSWORD=Password123!

# Optional — which environment to run against (see config/environments.ts).
# Defaults to "local". No other environments are defined yet.
QA_ENV=local
